# Octahedron with smooth normals
# Vertices
v 1 0 0
v 0 1 0
v 0 0 1
v 0 -1 0
v 0 0 -1
v -1 0 0

# Vertex normals (normalized vertex positions for smooth shading)
vn 1 0 0
vn 0 1 0
vn 0 0 1
vn 0 -1 0
vn 0 0 -1
vn -1 0 0

# UV coordinates (spherical mapping)
vt 0.0 0.5
vt 0.25 1.0
vt 0.25 0.5
vt 0.25 0.0
vt 0.75 0.5
vt 0.5 0.5

# Faces with vertex/texcoord/normal indices
f 1/1/1 2/2/2 3/3/3
f 1/1/1 3/3/3 4/4/4
f 1/1/1 4/4/4 5/5/5
f 1/1/1 5/5/5 2/2/2
f 2/2/2 5/5/5 6/6/6
f 2/2/2 6/6/6 3/3/3
f 3/3/3 6/6/6 4/4/4
f 4/4/4 6/6/6 5/5/5